    { objectName: "Áo giáp chống đạn TG-H", pic: "https://playerhub.df.qq.com/playerhub/60004/object/11050003003.png", protectLevel: 4 },
    { objectName: "Áo giáp hạng nặng DEFENDER-2", pic: "https://playerhub.df.qq.com/playerhub/60004/object/11050005001.png", protectLevel: 5 },
    { objectName: "Áo giáp pháo đài Fort Redut", pic: "https://playerhub.df.qq.com/playerhub/60004/object/11050006001.png", protectLevel: 6 }
  ];

  class EquipmentGame {
    constructor() {
      this.generateBtn = document.getElementById('equipGenerateBtn');
      this.historyBtn = document.getElementById('equipHistoryBtn');
      this.historyModal = document.getElementById('equipHistoryModal');
      this.historyList = document.getElementById('equipHistoryList');
      this.historyClose = document.getElementById('equipHistoryClose');
      this.historyClear = document.getElementById('equipHistoryClear');
      this.copyBtn = document.getElementById('equipCopyBtn');
      this.mapSelect = document.getElementById('equipMapSelect');
      this.diffSelect = document.getElementById('equipDiffSelect');

      this.currentDifficulty = ''; // '', '常规', '机密', '绝密'
      this.currentResult = null;
      this.isGenerating = false;
      this.audioNormal = new Audio('/fun/crate/audio/loot_normal.ogg');
      this.audioEpic = new Audio('/fun/crate/audio/loot_epic.ogg');
      this.audioMythic = new Audio('/fun/crate/audio/loot_mythic.ogg');

      this.init();
    }

    init() {
      if (!this.generateBtn) return;

      this.loadSavedOptions();

      this.generateBtn.addEventListener('click', () => this.generate());
      this.historyBtn?.addEventListener('click', () => this.openHistory());
      this.historyClose?.addEventListener('click', () => this.closeHistory());
      this.historyClear?.addEventListener('click', () => this.clearHistory());
      this.copyBtn?.addEventListener('click', () => this.copyCurrentLoadout());

      this.historyModal?.addEventListener('click', (e) => {
        if (e.target === this.historyModal) this.closeHistory();
      });

      // Map selection changes: maps 2 (Longbow) and 6 (AZ3) disable Khó (Tuyệt mật)
      this.mapSelect?.addEventListener('change', () => {
        this.updateDifficultyAvailability();
        this.saveCurrentOptions();
      });

      // Difficulty dropdown selection changes
      this.diffSelect?.addEventListener('change', () => {
        this.setDifficulty(this.diffSelect.value);
        this.saveCurrentOptions();
      });

      // Difficulty pills (Dễ, Thường, Khó) 1-click selection & deselect
      document.querySelectorAll('.equip-diff-pill').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          if (btn.classList.contains('is-disabled')) return;
          const diff = btn.getAttribute('data-diff') || '';
          // Click active one again -> reset to random ('')
          if (this.currentDifficulty === diff) {
            this.setDifficulty('');
          } else {
            this.setDifficulty(diff);
          }
          this.saveCurrentOptions();
        });
      });

      // Toggle pills 1-CLICK INSTANT TOGGLE (prevents browser label double-toggle bug)
      document.querySelectorAll('.equip-toggle-pill:not(.equip-diff-pill)').forEach(pill => {
        const input = pill.querySelector('input');
        if (!input) return;

        pill.addEventListener('click', (e) => {
          e.preventDefault();
          if (pill.classList.contains('is-disabled')) return;
          input.checked = !input.checked;
          input.dispatchEvent(new Event('change'));
        });

        input.addEventListener('change', () => {
          pill.classList.toggle('checked', input.checked);

          // Handle mutually exclusive options (lucky vs unlucky)
          if (input.id === 'optLucky' && input.checked) {
            const unlucky = document.getElementById('optUnlucky');
            if (unlucky) {
              unlucky.checked = false;
              document.getElementById('pillUnlucky')?.classList.remove('checked');
            }
          } else if (input.id === 'optUnlucky' && input.checked) {
            const lucky = document.getElementById('optLucky');
            if (lucky) {
              lucky.checked = false;
              document.getElementById('pillLucky')?.classList.remove('checked');
            }
          }

          this.saveCurrentOptions();
        });
      });

      // Restore last history entry if available, otherwise show initial loadout
      const hist = this.getHistory();
      if (hist.length > 0 && hist[0].result) {
        this.displayLoadoutDirect(hist[0].result);
      } else {
        const initial = this.generateFallbackLoadout({});
        this.displayLoadoutDirect(initial);
      }
    }

    setDifficulty(diff) {
      this.currentDifficulty = diff || '';
      if (this.diffSelect) this.diffSelect.value = this.currentDifficulty;

      document.querySelectorAll('.equip-diff-pill').forEach(btn => {
        const bDiff = btn.getAttribute('data-diff');
        btn.classList.toggle('checked', bDiff === this.currentDifficulty);
      });
    }

    updateDifficultyAvailability() {
      const mapVal = this.mapSelect?.value;
      const isRestricted = mapVal === '2' || mapVal === '6';
      const pillHard = document.getElementById('pillDiffHard');
      const optHard = this.diffSelect?.querySelector('option[value="绝密"]');

      if (pillHard) {
        if (isRestricted) {
          pillHard.classList.add('is-disabled');
          if (optHard) optHard.disabled = true;
          if (this.currentDifficulty === '绝密') {
            this.setDifficulty('机密'); // Fallback to Thường (Cơ mật)
          }
        } else {
          pillHard.classList.remove('is-disabled');
          if (optHard) optHard.disabled = false;
        }
      }
    }

    loadSavedOptions() {
      try {
        const raw = localStorage.getItem('random-equipment-options');
        if (!raw) return;
        const opts = JSON.parse(raw);

        if (this.mapSelect && opts.mapId !== undefined) {
          this.mapSelect.value = opts.mapId || '';
        }

        if (opts.difficulty !== undefined) {
          this.setDifficulty(opts.difficulty);
        }

        const toggles = [
          { id: 'optLucky', pill: 'pillLucky' },
          { id: 'optUnlucky', pill: 'pillUnlucky' },
          { id: 'optNoPistol', pill: 'pillNoPistol' },
          { id: 'optNoShotgun', pill: 'pillNoShotgun' },
          { id: 'optNoSniper', pill: 'pillNoSniper' },
          { id: 'optFast', pill: 'pillFast' }
        ];

        toggles.forEach(t => {
          const el = document.getElementById(t.id);
          const p = document.getElementById(t.pill);
          if (el && opts[t.id] !== undefined) {
            el.checked = !!opts[t.id];
            p?.classList.toggle('checked', el.checked);
          }
        });

        this.updateDifficultyAvailability();
      } catch (e) {}
    }

    saveCurrentOptions() {
      try {
        const opts = {
          mapId: this.mapSelect?.value || '',
          difficulty: this.currentDifficulty || '',
          optLucky: document.getElementById('optLucky')?.checked || false,
          optUnlucky: document.getElementById('optUnlucky')?.checked || false,
          optNoPistol: document.getElementById('optNoPistol')?.checked || false,
          optNoShotgun: document.getElementById('optNoShotgun')?.checked || false,
          optNoSniper: document.getElementById('optNoSniper')?.checked || false,
          optFast: document.getElementById('optFast')?.checked || false
        };
        localStorage.setItem('random-equipment-options', JSON.stringify(opts));
      } catch (e) {}
    }

    async generate() {
      if (this.isGenerating) return;
      this.isGenerating = true;
      this.generateBtn.disabled = true;
      this.generateBtn.innerHTML = '⚡ ĐANG DÒ QUÉT TRANG BỊ...';

      // Show radar overlays on all 5 stages
      const radarIds = ['radarHero', 'radarWeapon', 'radarHelmet', 'radarArmor', 'radarRules'];
      radarIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.display = 'flex';
      });

      const payload = {
        mapId: this.mapSelect?.value ? parseInt(this.mapSelect.value, 10) : null,
        difficulty: this.currentDifficulty || null,
        onlyClassified: this.currentDifficulty === '绝密',
        luckyDraw: document.getElementById('optLucky')?.checked || false,
        unluckyDraw: document.getElementById('optUnlucky')?.checked || false,
        noPistol: document.getElementById('optNoPistol')?.checked || false,
        noShotgun: document.getElementById('optNoShotgun')?.checked || false,
        noSniper: document.getElementById('optNoSniper')?.checked || false,
        fastReveal: document.getElementById('optFast')?.checked || false
      };

      let result = null;
      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 6500);
        const res = await fetch('/api/random-equipment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          signal: controller.signal
        });
        clearTimeout(timeoutId);

        if (res.ok) {
          const json = await res.json();
          if (json.success && json.data) {
            result = this.normalizeApiData(json.data);
          }
        }
      } catch (err) {
        console.warn('API fetch warning, employing high-accuracy local generator:', err);
      }

      if (!result) {
        result = this.generateFallbackLoadout(payload);
      }

      // Enforce user selected difficulty if specified
      if (payload.difficulty) {
        result.map.difficulty = payload.difficulty;
        result.map.difficultyVi = DIFFICULTY_DATA[payload.difficulty]?.nameVi || payload.difficulty;
      }

      this.currentResult = result;
      this.saveHistory(result);

      // Preload images to eliminate rendering flicker
      await this.preloadImages([
        result.map?.pic,
        result.operator?.pic,
        result.operator?.avatar,
        result.weapon?.pic,
        result.helmet?.pic,
        result.armor?.pic
      ]);

      // Staged reveal sequence (5 stages)
      const stepDelay = payload.fastReveal ? 450 : 800;

      // 1. Reveal Hero Card (Map & Operator)
      setTimeout(() => {
        this.renderHeroCard(result);
        const rHero = document.getElementById('radarHero');
        if (rHero) rHero.style.display = 'none';
        this.playSound(2);
      }, stepDelay);

      // 2. Reveal Weapon Card
      setTimeout(() => {
        this.renderWeaponCard(result);
        const rWep = document.getElementById('radarWeapon');
        if (rWep) rWep.style.display = 'none';
        this.playSound(3);
      }, stepDelay * 2);

      // 3. Reveal Helmet Card
      setTimeout(() => {
        this.renderHelmetCard(result);
        const rHel = document.getElementById('radarHelmet');
        if (rHel) rHel.style.display = 'none';
        this.playSound(result.helmet?.protectLevel || 3);
      }, stepDelay * 3);

      // 4. Reveal Armor Card
      setTimeout(() => {
        this.renderArmorCard(result);
        const rArm = document.getElementById('radarArmor');
        if (rArm) rArm.style.display = 'none';
        this.playSound(result.armor?.protectLevel || 3);
      }, stepDelay * 4);

      // 5. Reveal Gun Rules Card & Complete
      setTimeout(() => {
        this.renderRulesCard(result);
        const rRul = document.getElementById('radarRules');
        if (rRul) rRul.style.display = 'none';
        this.playSound(result.weapon?.gunDetail?.unlimited ? 6 : 4);

        this.isGenerating = false;
        this.generateBtn.disabled = false;
        this.generateBtn.innerHTML = '🎲 TẠO TRANG BỊ NGẪU NHIÊN';
      }, stepDelay * 5);
    }

    displayLoadoutDirect(data) {
      if (!data) return;
      this.currentResult = data;
      this.renderHeroCard(data);
      this.renderWeaponCard(data);
      this.renderHelmetCard(data);
      this.renderArmorCard(data);
      this.renderRulesCard(data);

      ['radarHero', 'radarWeapon', 'radarHelmet', 'radarArmor', 'radarRules'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.display = 'none';
      });
    }

    renderHeroCard(data) {
      if (!data.map || !data.operator) return;
      const mapImg = document.getElementById('equipMapImg');
      const opImg = document.getElementById('equipOperatorImg');
      const mapName = document.getElementById('equipMapName');
      const diffBadge = document.getElementById('equipDiffBadge');
      const opAvatar = document.getElementById('equipOperatorAvatar');
      const opName = document.getElementById('equipOperatorName');
      const opClass = document.getElementById('equipOperatorClass');

      if (mapImg) mapImg.src = data.map.pic || '';
      if (opImg) {
        opImg.src = data.map.pic && data.operator.pic ? data.operator.pic : '';
        const opPos = data.operator.pos || OPERATOR_DATA[data.operator.name]?.pos || OPERATOR_DATA[data.operator.nameVi]?.pos || '65%';
        opImg.style.objectPosition = `${opPos} top`;
      }
      if (mapName) mapName.textContent = data.map.nameVi || data.map.map || 'Bản đồ Delta Force';

      if (diffBadge) {
        const diffInfo = DIFFICULTY_DATA[data.map.difficulty] || { nameVi: data.map.difficulty, css: 'diff-jimi' };
        diffBadge.textContent = diffInfo.nameVi;
        diffBadge.className = `equip-diff-badge ${diffInfo.css}`;
      }

      if (opAvatar) opAvatar.src = data.operator.avatar || '';
      if (opName) opName.textContent = data.operator.nameVi || data.operator.name || 'Đặc vụ';
    }

    renderWeaponCard(data) {
      if (!data.weapon) return;
      const wepImg = document.getElementById('equipWeaponImg');
      const wepName = document.getElementById('equipWeaponName');
      const wepClass = document.getElementById('equipWeaponClass');
      const tagsContainer = document.getElementById('equipWeaponTags');

      if (wepImg) wepImg.src = data.weapon.pic || '';
      if (wepName) wepName.textContent = data.weapon.objectNameVi || data.weapon.objectName || 'Vũ khí';
      if (wepClass) {
        wepClass.textContent = (data.weapon.secondClassVi || data.weapon.secondClassCN || 'SÚNG TÁC CHIẾN').toUpperCase();
      }

      if (tagsContainer) {
        const detail = data.weapon.gunDetail || {};
        const tags = [];
        if (detail.fireModeVi || detail.fireMode) tags.push(detail.fireModeVi || detail.fireMode);
        if (detail.selectedAmmoGrade) tags.push(`Đạn cấp ${detail.selectedAmmoGrade}`);
        if (detail.caliber) tags.push(detail.caliber);
        if (detail.maxAccessoryCount) tags.push(`Tối đa ${detail.maxAccessoryCount} phụ kiện`);

        tagsContainer.innerHTML = tags.map(t => `<span class="equip-tag">${t}</span>`).join('');
      }
    }

    renderHelmetCard(data) {
      if (!data.helmet) return;
      const helImg = document.getElementById('equipHelmetImg');
      const helName = document.getElementById('equipHelmetName');
      const lvlEl = document.getElementById('equipHelmetLvl');
      const descEl = document.getElementById('equipHelmetDesc');
      const cardEl = document.getElementById('cardHelmet');

      const lvl = data.helmet.protectLevel || 3;
      if (helImg) helImg.src = data.helmet.pic || '';
      if (helName) helName.textContent = data.helmet.objectNameVi || data.helmet.objectName || 'Mũ bảo hộ';
      if (lvlEl) {
        lvlEl.textContent = `LV ${lvl}`;
        lvlEl.className = `equip-level-badge lvl-${lvl}`;
      }
      if (descEl) descEl.textContent = `Bảo vệ đầu cấp ${lvl}`;
      if (cardEl) {
        cardEl.className = `equip-gear-card lvl-border-${lvl}`;
      }
    }

    renderArmorCard(data) {
      if (!data.armor) return;
      const armImg = document.getElementById('equipArmorImg');
      const armName = document.getElementById('equipArmorName');
      const lvlEl = document.getElementById('equipArmorLvl');
      const descEl = document.getElementById('equipArmorDesc');
      const cardEl = document.getElementById('cardArmor');

      const lvl = data.armor.protectLevel || 3;
      if (armImg) armImg.src = data.armor.pic || '';
      if (armName) armName.textContent = data.armor.objectNameVi || data.armor.objectName || 'Áo giáp bảo vệ';
      if (lvlEl) {
        lvlEl.textContent = `LV ${lvl}`;
        lvlEl.className = `equip-level-badge lvl-${lvl}`;
      }
      if (descEl) descEl.textContent = `Bảo vệ thân cấp ${lvl}`;
      if (cardEl) {
        cardEl.className = `equip-gear-card lvl-border-${lvl}`;
      }
    }

    renderRulesCard(data) {
      const detail = data.weapon?.gunDetail || {};
      const statusBadge = document.getElementById('equipGunRuleStatus');
      const ruleBody = document.getElementById('equipGunRuleBody');

      if (!ruleBody) return;

      if (detail.unlimited) {
        if (statusBadge) {
          statusBadge.textContent = 'TỰ DO';
          statusBadge.style.color = 'var(--mg-primary)';
        }
        ruleBody.innerHTML = `
          <div style="padding:4px 0;">
            <p style="margin:0;font-size:13px;font-weight:700;color:#f59e0b;">🎯 Bản đồ không giới hạn phụ kiện</p>
            <p style="margin:4px 0 0;font-size:12px;color:rgba(245, 158, 11, 0.75);">Tự do phối trang bị chiến thuật, G.T.I. chúc bạn may mắn!</p>
          </div>
        `;
      } else {
        if (statusBadge) {
          statusBadge.textContent = 'CHIẾN THUẬT';
          statusBadge.style.color = '#38bdf8';
        }
        const minQ = QUALITY_MAP[detail.minAccessoryQuality] || { nameVi: detail.minAccessoryQuality || 'Xanh lục', css: 'qual-green' };
        const maxQ = QUALITY_MAP[detail.maxAccessoryQuality] || { nameVi: detail.maxAccessoryQuality || 'Tím', css: 'qual-purple' };

        ruleBody.innerHTML = `
          <p id="equipRuleLine1" style="margin:0;font-size:13px;line-height:1.5;color:#e1effa;">
            Tối đa lắp <b style="color:#fff;">${detail.maxAccessoryCount || 8}</b> phụ kiện <span class="equip-quality-tag ${minQ.css}">${minQ.nameVi}</span>
          </p>
          <p id="equipRuleLine2" style="margin:4px 0 0;font-size:12px;color:var(--mg-text-muted);">
            Trong đó <b style="color:#fff;">${detail.highQualityAccessoryCount || 2}</b> phụ kiện có thể nâng lên <span class="equip-quality-tag ${maxQ.css}">${maxQ.nameVi}</span>
          </p>
        `;
      }
    }

    normalizeApiData(raw) {
      const copy = JSON.parse(JSON.stringify(raw));

      // Translate map
      const mapRaw = copy.map?.map || '';
      const mapObj = MAP_DATA[mapRaw] || {};
      copy.map.nameVi = mapObj.nameVi || mapRaw;

      // Translate difficulty
      const diffRaw = copy.map?.difficulty || '';
      const diffObj = DIFFICULTY_DATA[diffRaw] || {};
      copy.map.difficultyVi = diffObj.nameVi || diffRaw;

      // Translate operator
      const opRaw = copy.operator?.name || '';
      const opObj = OPERATOR_DATA[opRaw] || {};
      copy.operator.nameVi = opObj.nameVi || opRaw;
      if (opObj.avatar) {
        copy.operator.avatar = opObj.avatar;
      }
      if (opObj.pic) {
        copy.operator.pic = opObj.pic;
      }
      copy.operator.pos = opObj.pos || '65%';

      // Translate weapon
      if (copy.weapon) {
        const wepRawClass = copy.weapon.secondClassCN || '';
        copy.weapon.secondClassVi = WEAPON_CLASS_MAP[wepRawClass] || wepRawClass;
        copy.weapon.objectNameVi = this.translateWeaponName(copy.weapon.objectName);

        if (copy.weapon.gunDetail) {
          const fm = copy.weapon.gunDetail.fireMode || '';
          copy.weapon.gunDetail.fireModeVi = FIRE_MODE_MAP[fm] || fm;
        }
      }

      // Translate helmet & armor
      if (copy.helmet) {
        copy.helmet.objectNameVi = this.translateGearName(copy.helmet.objectName, 'Mũ');
      }
      if (copy.armor) {
        copy.armor.objectNameVi = this.translateGearName(copy.armor.objectName, 'Giáp');
      }

      return copy;
    }

    translateWeaponName(name) {
      if (!name) return 'Vũ khí';
      return name
        .replace(/战斗步枪/g, ' - Battle Rifle')
        .replace(/突击步枪/g, '')
        .replace(/射手步枪/g, '')
        .replace(/轻机枪/g, '')
        .replace(/冲锋枪/g, '')
        .replace(/狙击步枪/g, '')
        .trim();
    }

    translateGearName(name, prefix) {
      if (!name) return prefix;
      let vi = name
        .replace(/久战/g, 'Cựu Chiến ')
        .replace(/重型/g, 'Hạng Nặng ')
        .replace(/轻型/g, 'Hạng Nhẹ ')
        .replace(/夜视/g, 'Nhìn Đêm ')
        .replace(/战术/g, 'Chiến Thuật ')
        .replace(/防弹/g, 'Chống Đạn ')
        .replace(/头盔/g, 'Mũ ')
        .replace(/背心/g, 'Giáp ')
        .replace(/胸挂/g, 'Giáp Ngực ')
        .replace(/护甲/g, 'Giáp ');
      return vi.trim() || `${prefix} Chiến Thuật`;
    }

    generateFallbackLoadout(opts) {
      const mapKeys = opts.mapId ? [opts.mapId.toString()] : ['1', '2', '3', '4', '5', '6'];
      const chosenMapKey = mapKeys[Math.floor(Math.random() * mapKeys.length)];
      const mapInfo = MAP_DATA[chosenMapKey] || MAP_DATA['4'];

      let diff = '常规';
      if (opts.difficulty) {
        diff = opts.difficulty;
      } else if (opts.onlyClassified) {
        diff = '绝密';
      } else if (opts.luckyDraw) {
        diff = Math.random() > 0.4 ? '绝密' : '机密';
      } else if (opts.unluckyDraw) {
        diff = '常规';
      } else {
        const diffChoices = ['常规', '机密', '绝密'];
        diff = diffChoices[Math.floor(Math.random() * diffChoices.length)];
      }

      const operator = FALLBACK_OPERATORS[Math.floor(Math.random() * FALLBACK_OPERATORS.length)];

      let availableWeapons = FALLBACK_WEAPONS.filter(w => {
        if (opts.noPistol && w.type === 'pistol') return false;
        if (opts.noShotgun && w.type === 'shotgun') return false;
        if (opts.noSniper && w.type === 'sniper') return false;
        return true;
      });

      if (availableWeapons.length === 0) availableWeapons = FALLBACK_WEAPONS;
      const weapon = JSON.parse(JSON.stringify(availableWeapons[Math.floor(Math.random() * availableWeapons.length)]));

      let helmet, armor;
      if (opts.luckyDraw) {
        helmet = FALLBACK_HELMETS.slice(2)[Math.floor(Math.random() * (FALLBACK_HELMETS.length - 2))];
        armor = FALLBACK_ARMORS.slice(2)[Math.floor(Math.random() * (FALLBACK_ARMORS.length - 2))];
        if (Math.random() > 0.5) weapon.gunDetail.unlimited = true;
      } else if (opts.unluckyDraw) {
        helmet = FALLBACK_HELMETS.slice(0, 2)[Math.floor(Math.random() * 2)];
        armor = FALLBACK_ARMORS.slice(0, 2)[Math.floor(Math.random() * 2)];
        weapon.gunDetail.unlimited = false;
        weapon.gunDetail.selectedAmmoGrade = 2;
      } else {
        helmet = FALLBACK_HELMETS[Math.floor(Math.random() * FALLBACK_HELMETS.length)];
        armor = FALLBACK_ARMORS[Math.floor(Math.random() * FALLBACK_ARMORS.length)];
      }

      return {
        map: {
          map: mapInfo.nameVi,
          nameVi: mapInfo.nameVi,
          difficulty: diff,
          difficultyVi: DIFFICULTY_DATA[diff]?.nameVi || diff,
          pic: mapInfo.pic
        },
        operator: {
          name: operator.name,
          nameVi: operator.nameVi || operator.name,
          classVi: operator.classVi || '',
          avatar: operator.avatar,
          pic: operator.pic,
          pos: operator.pos || '65%'
        },
        weapon: {
          objectName: weapon.objectName,
          objectNameVi: weapon.objectName,
          pic: weapon.pic,
          secondClassCN: weapon.secondClassCN,
          secondClassVi: weapon.secondClassCN,
          gunDetail: weapon.gunDetail
        },
        helmet: {
          objectName: helmet.objectName,
          objectNameVi: helmet.objectName,
          pic: helmet.pic,
          protectLevel: helmet.protectLevel
        },
        armor: {
          objectName: armor.objectName,
          objectNameVi: armor.objectName,
          pic: armor.pic,
          protectLevel: armor.protectLevel
        }
      };
    }

    async preloadImages(urls) {
      const validUrls = (urls || []).filter(Boolean);
      await Promise.all(validUrls.map(u => new Promise(resolve => {
        const img = new Image();
        img.onload = () => resolve(true);
        img.onerror = () => resolve(false);
        img.src = u;
      })));
    }

    playSound(level) {
      try {
        let sound = this.audioNormal;
        if (level >= 5) sound = this.audioMythic;
        else if (level >= 3) sound = this.audioEpic;

        sound.currentTime = 0;
        sound.volume = 0.5;
        sound.play().catch(() => {});
      } catch (e) {}
    }

    copyCurrentLoadout() {
      if (!this.currentResult) return;
      const res = this.currentResult;
      const detail = res.weapon?.gunDetail || {};

      let ruleText = 'Chiến thuật tiêu chuẩn';
      if (detail.unlimited) {
        ruleText = 'Không giới hạn phụ kiện (Tự do)';
      } else {
        const minQ = QUALITY_MAP[detail.minAccessoryQuality]?.nameVi || detail.minAccessoryQuality || 'Xanh lục';
        const maxQ = QUALITY_MAP[detail.maxAccessoryQuality]?.nameVi || detail.maxAccessoryQuality || 'Tím';
        ruleText = `Tối đa ${detail.maxAccessoryCount || 8} phụ kiện ${minQ} (${detail.highQualityAccessoryCount || 2} có thể nâng lên ${maxQ})`;
      }

      const opName = res.operator?.nameVi || res.operator?.name || 'Đặc vụ';
      const text = [
        '🎯 [DFVN] BỘ TRANG BỊ TÁC CHIẾN DELTA FORCE',
        `📍 Bản đồ: ${res.map?.nameVi || res.map?.map} (${res.map?.difficultyVi || res.map?.difficulty})`,
        `👤 Đặc vụ: ${opName}`,
        `🔫 Vũ khí chính: ${res.weapon?.objectNameVi || res.weapon?.objectName} [${res.weapon?.secondClassVi || res.weapon?.secondClassCN}] (Đạn cấp ${detail.selectedAmmoGrade || '?'}, ${detail.fireModeVi || detail.fireMode || 'Tự động'})`,
        `🪖 Mũ bảo hiểm: ${res.helmet?.objectNameVi || res.helmet?.objectName} (LV ${res.helmet?.protectLevel})`,
        `🛡️ Giáp chống đạn: ${res.armor?.objectNameVi || res.armor?.objectName} (LV ${res.armor?.protectLevel})`,
        `⚙️ Quy tắc phối súng: ${ruleText}`
      ].join('\n');

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => {
          if (this.copyBtn) {
            const old = this.copyBtn.innerHTML;
            this.copyBtn.innerHTML = '✅ Đã sao chép!';
            setTimeout(() => { if (this.copyBtn) this.copyBtn.innerHTML = old; }, 2200);
          }
        });
      }
    }

    getHistory() {
      try {
        return JSON.parse(localStorage.getItem('random-equipment-history') || '[]');
      } catch (e) {
        return [];
      }
    }

    saveHistory(entry) {
      try {
        const hist = this.getHistory();
        hist.unshift({ result: entry, timestamp: Date.now() });
        localStorage.setItem('random-equipment-history', JSON.stringify(hist.slice(0, 50)));
      } catch (e) {}
    }

    openHistory() {
      if (!this.historyModal) return;
      this.historyModal.classList.add('open');
      const hist = this.getHistory();

      if (hist.length === 0) {
        this.historyList.innerHTML = '<p style="text-align:center;color:#70889f;padding:36px;">Chưa có lịch sử tạo trang bị nào</p>';
      } else {
        this.historyList.innerHTML = hist.map((h, idx) => {
          const d = new Date(h.timestamp);
          const time = `${d.getHours().toString().padStart(2, '0')}:${d.getMinutes().toString().padStart(2, '0')} - ${d.getDate().toString().padStart(2, '0')}/${(d.getMonth() + 1).toString().padStart(2, '0')}`;
          const res = h.result;
          const mapDiff = DIFFICULTY_DATA[res.map?.difficulty] || { nameVi: res.map?.difficulty || 'Bình thường', css: 'diff-jimi' };
          const detail = res.weapon?.gunDetail || {};

          let ruleSnippet = 'Không giới hạn';
          if (!detail.unlimited) {
            const minQ = QUALITY_MAP[detail.minAccessoryQuality]?.nameVi || detail.minAccessoryQuality || 'Xanh';
            ruleSnippet = `${detail.maxAccessoryCount || 8}× ${minQ}`;
          }

          return `
            <div class="mg-history-item" data-index="${idx}">
              <img class="mg-hist-bg" src="${res.map?.pic || ''}" alt="">
              <div class="mg-hist-top">
                <div style="display:flex;align-items:center;gap:10px;">
                  <span style="font-weight:900;color:#fff;font-size:14px;">${res.map?.nameVi || res.map?.map}</span>
                  <span class="equip-diff-badge ${mapDiff.css}">${mapDiff.nameVi}</span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                  <img src="${res.operator?.avatar || ''}" style="width:26px;height:26px;border-radius:50%;border:1px solid rgba(255,255,255,0.4);object-fit:cover;" alt="">
                  <span style="font-size:13px;font-weight:700;color:var(--mg-primary);">${res.operator?.nameVi || res.operator?.name}</span>
                  <span style="color:#627991;font-size:11px;margin-left:8px;">${time}</span>
                </div>
              </div>

              <div class="mg-hist-body">
                <div style="display:flex;align-items:center;gap:8px;min-width:0;">
                  <img src="${res.weapon?.pic || ''}" style="width:42px;height:28px;object-fit:contain;background:rgba(255,255,255,0.05);border-radius:4px;padding:2px;" alt="">
                  <div style="min-width:0;">
                    <div style="font-size:13px;font-weight:800;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${res.weapon?.objectNameVi || res.weapon?.objectName}</div>
                    <small style="color:#859bb2;font-size:11px;">Đạn cấp ${detail.selectedAmmoGrade || '?'}</small>
                  </div>
                </div>

                <div>
                  <span class="equip-level-badge lvl-${res.helmet?.protectLevel || 3}">LV ${res.helmet?.protectLevel || 3}</span>
                  <div style="font-size:11px;color:#859bb2;">Mũ bảo vệ</div>
                </div>

                <div>
                  <span class="equip-level-badge lvl-${res.armor?.protectLevel || 3}">LV ${res.armor?.protectLevel || 3}</span>
                  <div style="font-size:11px;color:#859bb2;">Giáp chống đạn</div>
                </div>

                <div style="text-align:right;">
                  <span class="equip-tag" style="background:#13263a;color:#7ee7ff;font-size:10.5px;">${ruleSnippet}</span>
                </div>
              </div>

              <div class="mg-hist-actions">
                <button class="mg-hist-btn" type="button" data-action="load" data-index="${idx}">👁️ Xem lại trên sàn</button>
                <button class="mg-hist-btn" type="button" data-action="copy" data-index="${idx}">📋 Sao chép</button>
              </div>
            </div>
          `;
        }).join('');

        // Action handlers for history items
        this.historyList.querySelectorAll('.mg-history-item').forEach(item => {
          const idx = parseInt(item.getAttribute('data-index'), 10);
          const entry = hist[idx]?.result;
          if (!entry) return;

          item.querySelector('[data-action="load"]')?.addEventListener('click', (e) => {
            e.stopPropagation();
            this.displayLoadoutDirect(entry);
            this.closeHistory();
          });

          item.querySelector('[data-action="copy"]')?.addEventListener('click', (e) => {
            e.stopPropagation();
            this.currentResult = entry;
            this.copyCurrentLoadout();
          });

          item.addEventListener('click', () => {
            this.displayLoadoutDirect(entry);
            this.closeHistory();
          });
        });
      }
    }

    closeHistory() {
      this.historyModal?.classList.remove('open');
    }

    clearHistory() {
      if (confirm('Xác nhận xóa toàn bộ lịch sử tạo trang bị? Thao tác này không thể hoàn tác.')) {
        localStorage.removeItem('random-equipment-history');
        this.openHistory();
      }
    }
  }

  // ==========================================================================
  // INITIALIZE ON DOM CONTENT LOADED
  // ==========================================================================
  document.addEventListener('DOMContentLoaded', () => {
    initTabs();
    window.crateGame = new CrateGame();
    window.morseGame = new MorseGame();
    window.hackerGame = new HackerGame();
    window.equipGame = new EquipmentGame();

    // Drawer subitem clicks on minigame page
    document.querySelectorAll('.category-subitem').forEach(sub => {
      sub.addEventListener('click', (e) => {
        const game = sub.getAttribute('data-game');
        if (game && TABS.includes(game)) {
          e.preventDefault();
          switchTab(game, true);
          const closeBtn = document.querySelector('.close-category');
          if (closeBtn) closeBtn.click();
        }
      });
    });
  });

})();
